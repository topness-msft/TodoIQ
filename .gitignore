__pycache__/
*.pyc
.env
node_modules/
.venv/
venv/
*.egg-info/
dist/
build/
test-runs/
.orchestrator/
.dashboard_config
.playwright-mcp/

# Runtime data — DB, logs, PID, test artifacts
data/

# Visual-test evidence (screenshots)
temp/

# Design hook cache
.impeccable/

# User-specific files (contain local paths / permission grants)
*.lnk
.claude/settings.local.json

# Scratch / temp scripts and outputs (root-level only)
/_tmp_*
/_parse_*
/_run_*
/_step*
/_exec_*
/_fetch_*
/_write_*
/_wc_*
/_wiq_*
/demo.py
/*.txt
# ...but dependency manifests are source, not scratch output. requirements.txt
# only escapes the rule above because it was tracked before it existed.
!/requirements.txt
!/requirements-dev.txt

# Verification screenshots and debug dumps dropped at the root during a
# session. manifest.json is tracked, so it is unaffected by the json rule.
/*.png
/deep-link-debug.json

# The agent-team findings ledger. Worth keeping on disk (132 reports of why
# things were done) but it is working notes, not source.
/findings/
/.copilot/
